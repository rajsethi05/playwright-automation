# Copy to .env and uncomment what you want to change. Defaults and docs: config/config.ts.

# BASE_URL=http://127.0.0.1:3000
# API_URL=http://127.0.0.1:3000

# Comma-separated: chromium, firefox, webkit
# BROWSERS=chromium
# HEADLESS=true

# Milliseconds
# TEST_TIMEOUT=30000
# EXPECT_TIMEOUT=5000
# ACTION_TIMEOUT=10000
# NAVIGATION_TIMEOUT=15000

# Defaults: 0 retries / auto workers locally, 2 retries / 1 worker when CI is set
# RETRIES=0
# WORKERS=4

# TRACE=on-first-retry
# SCREENSHOT=only-on-failure
# VIDEO=off

# TEST_USER_EMAIL_DOMAIN=juice-sh.op
# TEST_USER_PASSWORD=Passw0rd!
# TEST_USER_SECURITY_ANSWER=Mountains
